---
import Icon from './Icon.astro';
import { formatDate, getPosts, getTags, isoDate, postUrl } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const topics = getTags(posts).slice(0, 6);
---

<dialog class="search" aria-label="Search" aria-modal="true" data-search>
  <div class="panel" data-search-panel>
    <div class="field-row">
      <Icon name="search" class="field-row__icon" />
      <label class="field">
        <span class="visually-hidden">Search posts</span>
        <input
          type="search"
          placeholder="Search posts, topics, code…"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="go"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          data-search-input
        />
      </label>
      <button type="button" class="esc" aria-label="Close search" data-search-close><kbd>esc</kbd></button>
      <button type="button" class="cancel" data-search-close>Cancel</button>
    </div>

    <div class="body">
      <p class="notice" data-search-notice hidden></p>

      <!-- Empty state (no query) -->
      <div data-search-idle>
        <p class="label">Latest</p>
        <ul class="latest" role="list">
          {
            latest.map((post) => (
              <li>
                <a class="latest__row" href={postUrl(post)}>
                  <span class="tile" aria-hidden="true">
                    <Icon name="file" size={16} />
                  </span>
                  <span class="latest__title">{post.data.title}</span>
                  <time class="latest__date" datetime={isoDate(post.data.pubDate)}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="label label--topics">Topics</p>
        <div class="topics">
          {
            topics.map((tag) => (
              <button type="button" class="topic" data-search-topic={tag}>
                #{tag}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Results -->
      <p class="label count" aria-live="polite" data-search-count></p>
      <div id="search-results" class="results" role="listbox" aria-label="Search results" data-search-results></div>

      <!-- No results -->
      <div class="empty" data-search-empty hidden>
        <p class="empty__title">No results for “<span data-search-term></span>”</p>
        <p class="empty__hint">Try a shorter word, or a topic like #astro or #css.</p>
      </div>

      <a class="browse" href="/blog/" data-search-browse hidden>Browse all posts <Icon name="arrow-right" inline /></a>
    </div>

    <div class="foot">
      <span class="foot__keys">
        <span>
          <kbd><Icon name="arrow-up" inline /><span class="visually-hidden">Up arrow</span></kbd>
          <kbd><Icon name="arrow-down" inline /><span class="visually-hidden">Down arrow</span></kbd>
          navigate
        </span>
        <span><kbd><Icon name="enter" inline /><span class="visually-hidden">Enter</span></kbd> open</span>
        <span><kbd>esc</kbd> close</span>
      </span>
      <span>Search by Pagefind</span>
    </div>
  </div>

  <template data-search-tile>
    <span class="tile" aria-hidden="true"><Icon name="file" size={16} /></span>
  </template>
  <template data-search-enter>
    <Icon name="enter" inline />
  </template>
</dialog>

<style>
  /* The <dialog> covers the viewport; on desktop it is the scrim and the panel floats inside it. */
  .search {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--panel);
    color: var(--text);
    overflow: hidden;
  }

  .search:not([open]) {
    display: none;
  }

  .search::backdrop {
    background: transparent;
  }

  .panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--panel);
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    min-height: 60px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .field {
    display: flex;
    flex-grow: 1;
    min-width: 0;
  }

  .field input {
    flex-grow: 1;
    min-width: 0;
    height: 52px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    -webkit-appearance: none;
    appearance: none;
  }

  .field input::placeholder {
    color: var(--muted);
  }

  .esc {
    display: none;
    align-items: center;
    height: 44px;
    padding: 0 4px;
    border: 0;
    background: transparent;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-chip);
    padding: 2px 6px;
  }

  .cancel {
    height: 44px;
    padding: 0 4px 0 8px;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-size: 15px;
    font-weight: 500;
  }

  .body {
    flex-grow: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 8px 12px;
  }

  .label {
    margin: 10px 8px 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .label--topics {
    margin: 18px 8px 10px;
  }

  .count:empty {
    margin: 0;
  }

  .notice {
    margin: 8px 8px 4px;
    padding: 10px 12px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-card);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .notice :global(code) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
  }

  .latest {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest__row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px;
    border-radius: var(--radius-card);
    color: var(--text);
    text-decoration: none;
  }

  .latest__row:hover {
    background: var(--hover);
  }

  .latest__title {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 500;
  }

  .latest__date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--muted);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 8px 4px;
  }

  .topic {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .topic:hover {
    background: var(--hover);
  }

  .results :global(.result) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 8px;
    border-radius: var(--radius-card);
    color: var(--text);
    text-decoration: none;
  }

  .results :global(.result[aria-selected='true']) {
    background: var(--hover);
  }

  .results :global(.result .tile) {
    margin-top: 1px;
  }

  .results :global(.result__text) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex-grow: 1;
    min-width: 0;
  }

  .results :global(.result__title) {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  .results :global(.result__excerpt) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  .results :global(.result__meta) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .results :global(mark) {
    background: var(--mark);
    color: inherit;
    border-radius: 3px;
  }

  .results :global(.result__enter) {
    display: none;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .empty {
    padding: 40px 16px;
    text-align: center;
  }

  .empty__title {
    margin: 0;
    font-size: 15px;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .empty__hint {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  .browse {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-top: 4px;
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
  }

  .browse:hover {
    text-decoration: underline;
  }

  .browse[hidden],
  .empty[hidden],
  .notice[hidden],
  [data-search-idle][hidden] {
    display: none;
  }

  .foot {
    display: none;
  }

  .search :focus-visible {
    outline-offset: -2px;
  }

  @media (min-width: 768px) {
    .search {
      padding: 96px 32px 32px;
      background: var(--scrim);
      -webkit-backdrop-filter: blur(2px);
      backdrop-filter: blur(2px);
    }

    .panel {
      width: 100%;
      max-width: 640px;
      height: auto;
      max-height: 100%;
      margin: 0 auto;
      border: 1px solid var(--border);
      border-radius: var(--radius-panel);
      box-shadow: var(--panel-shadow);
      overflow: hidden;
    }

    .field-row {
      padding: 0 18px;
    }

    .esc {
      display: inline-flex;
    }

    .cancel {
      display: none;
    }

    .body {
      max-height: 420px;
      padding: 8px 10px 12px;
    }

    .results :global(.result[aria-selected='true'] .result__enter) {
      display: block;
    }

    .foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-shrink: 0;
      padding: 10px 18px;
      border-top: 1px solid var(--border);
      background: var(--foot);
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--muted);
    }

    .foot__keys {
      display: flex;
      gap: 14px;
    }

    .foot kbd {
      font-family: inherit;
      font-size: inherit;
      border-radius: 3px;
      padding: 0 4px;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { onPageLoad } from '../lib/page-load';

  // Pagefind's browser API (subset we use). The bundle is generated by `pagefind --site dist`.
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
    filters: Record<string, string[] | undefined>;
  }
  interface PagefindSearch {
    results: { id: string; data: () => Promise<PagefindResultData> }[];
  }
  interface Pagefind {
    options: (options: Record<string, unknown>) => Promise<void>;
    init: () => Promise<void>;
    search: (term: string | null, options?: Record<string, unknown>) => Promise<PagefindSearch>;
    filters: () => Promise<Record<string, Record<string, number>>>;
  }

  const MAX_RESULTS = 6;
  const DEBOUNCE_MS = 150;

  /* ---------- Loading (only on first open, then shared by every page) ---------- */

  let pagefindPromise: Promise<Pagefind | null> | null = null;

  function loadPagefind(): Promise<Pagefind | null> {
    pagefindPromise ??= (async () => {
      try {
        const url = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`;
        const pagefind: Pagefind = await import(/* @vite-ignore */ url);
        await pagefind.options({ excerptLength: 24 });
        await pagefind.init();
        return pagefind;
      } catch {
        return null;
      }
    })();
    return pagefindPromise;
  }

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!,
    );
  const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  /** Wraps each query word found in `text` in <mark>. */
  function highlight(text: string, query: string): string {
    const words = query.split(/\s+/).filter(Boolean).map(escapeRegExp);
    if (!words.length) return escapeHtml(text);
    const pattern = new RegExp(`(${words.join('|')})`, 'gi');
    return text
      .split(pattern)
      .map((part, i) => (i % 2 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)))
      .join('');
  }

  type View = 'idle' | 'results' | 'empty';

  onPageLoad((signal) => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
    // Only Home and Article have the pop-up, but this script stays loaded on every other page.
    if (dialog) setUpSearch(dialog, signal);
  });

  function setUpSearch(dialog: HTMLDialogElement, signal: AbortSignal) {
    const panel = dialog.querySelector<HTMLElement>('[data-search-panel]')!;
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const idle = dialog.querySelector<HTMLElement>('[data-search-idle]')!;
    const count = dialog.querySelector<HTMLElement>('[data-search-count]')!;
    const list = dialog.querySelector<HTMLElement>('[data-search-results]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-search-empty]')!;
    const emptyTerm = dialog.querySelector<HTMLElement>('[data-search-term]')!;
    const browse = dialog.querySelector<HTMLAnchorElement>('[data-search-browse]')!;
    const notice = dialog.querySelector<HTMLElement>('[data-search-notice]')!;
    const tileTemplate = dialog.querySelector<HTMLTemplateElement>('[data-search-tile]')!;
    const enterTemplate = dialog.querySelector<HTMLTemplateElement>('[data-search-enter]')!;

    let trigger: HTMLElement | null = null;
    let active = 0;
    let requestId = 0;
    let debounce: number | undefined;
    let pending = false;

    /* ---------- Open / close ---------- */

    function open() {
      if (dialog.open) {
        input.focus();
        return;
      }
      trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      document.dispatchEvent(new CustomEvent('search:open'));
      dialog.showModal();
      document.documentElement.classList.add('scroll-locked');
      input.focus();
      input.select();
      void loadPagefind().then((pagefind) => {
        if (pagefind) return;
        notice.innerHTML = import.meta.env.DEV
          ? 'Search runs on the built site. Run <code>npm run build</code> then <code>npm run preview</code> to try it.'
          : 'Search is unavailable right now. <a href="/blog/">Browse all posts</a> instead.';
        notice.hidden = false;
      });
    }

    function close() {
      if (dialog.open) dialog.close();
    }

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('scroll-locked');
      const fallback = document.querySelector<HTMLElement>('[data-search-open]');
      (trigger && trigger.isConnected && trigger.closest('[data-search-open]') ? trigger : fallback)?.focus();
      trigger = null;
    });

    document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open));
    dialog.querySelectorAll('[data-search-close]').forEach((button) => button.addEventListener('click', close));

    // Click on the scrim (outside the panel) closes.
    dialog.addEventListener('click', (event) => {
      if (!panel.contains(event.target as Node)) close();
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if ((event.metaKey || event.ctrlKey) && !event.altKey && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          open();
        }
      },
      { signal },
    );

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      } else if (event.key === 'Tab') {
        trapFocus(event);
      }
    });

    function trapFocus(event: KeyboardEvent) {
      const focusable = [
        ...panel.querySelectorAll<HTMLElement>('a[href], button, input, [tabindex]:not([tabindex="-1"])'),
      ].filter((el) => !el.closest('[hidden]') && el.getClientRects().length > 0);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    /* ---------- Rendering ---------- */

    function setView(view: View) {
      idle.hidden = view !== 'idle';
      list.hidden = view !== 'results';
      empty.hidden = view !== 'empty';
      browse.hidden = view === 'idle';
      input.setAttribute('aria-expanded', String(view === 'results'));
      if (view === 'idle') {
        count.textContent = '';
        count.classList.remove('visually-hidden');
        list.replaceChildren();
        input.removeAttribute('aria-activedescendant');
      }
    }

    function setActive(index: number) {
      const options = [...list.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!options.length) return;
      active = Math.max(0, Math.min(index, options.length - 1));
      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === active)));
      const current = options[active];
      input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    }

    function renderResults(items: PagefindResultData[], total: number, query: string, isTagQuery: boolean) {
      count.classList.remove('visually-hidden');
      count.textContent = `${total} ${total === 1 ? 'result' : 'results'}`;

      const fragment = document.createDocumentFragment();
      items.forEach((item, i) => {
        const link = document.createElement('a');
        link.className = 'result';
        link.id = `search-option-${i}`;
        link.href = item.url;
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');

        const title = item.meta.title ?? item.url;
        const tags = (item.filters.tag ?? []).map((tag) => `#${tag}`).join(' ');
        const meta = [item.meta.date, tags].filter(Boolean).join(' · ');
        // The post description reads better than a mid-sentence body excerpt; fall back to Pagefind's.
        const excerpt = item.meta.description
          ? isTagQuery
            ? escapeHtml(item.meta.description)
            : highlight(item.meta.description, query)
          : item.excerpt;

        link.append(tileTemplate.content.cloneNode(true));
        const text = document.createElement('span');
        text.className = 'result__text';
        text.innerHTML =
          `<span class="result__title">${highlight(title, query)}</span>` +
          `<span class="result__excerpt">${excerpt}</span>` +
          (meta ? `<span class="result__meta">${escapeHtml(meta)}</span>` : '');
        link.append(text);

        const enter = document.createElement('span');
        enter.className = 'result__enter';
        enter.setAttribute('aria-hidden', 'true');
        enter.append(enterTemplate.content.cloneNode(true));
        link.append(enter);

        link.addEventListener('mousemove', () => {
          if (active !== i) setActive(i);
        });
        fragment.append(link);
      });

      list.replaceChildren(fragment);
      setView('results');
      setActive(0);
    }

    function renderEmpty(query: string) {
      emptyTerm.textContent = query;
      count.textContent = 'No results';
      count.classList.add('visually-hidden');
      list.replaceChildren();
      input.removeAttribute('aria-activedescendant');
      setView('empty');
    }

    /* ---------- Searching ---------- */

    async function runSearch(raw: string) {
      const id = ++requestId;
      const query = raw.trim();
      if (!query) {
        setView('idle');
        return;
      }

      const pagefind = await loadPagefind();
      if (!pagefind || id !== requestId) return;

      const isTagQuery = query.startsWith('#');
      let search: PagefindSearch;
      let textForHighlight = query;

      if (isTagQuery) {
        // "#ast" matches every tag containing "ast"; results newest first.
        const needle = query.slice(1).toLowerCase();
        textForHighlight = needle;
        const allTags = Object.keys((await pagefind.filters()).tag ?? {});
        const tags = needle ? allTags.filter((tag) => tag.includes(needle)) : allTags;
        search = tags.length
          ? await pagefind.search(null, { filters: { tag: { any: tags } }, sort: { date: 'desc' } })
          : { results: [] };
      } else {
        search = await pagefind.search(query);
      }
      if (id !== requestId) return;

      if (!search.results.length) {
        renderEmpty(query);
        return;
      }
      const items = await Promise.all(search.results.slice(0, MAX_RESULTS).map((result) => result.data()));
      if (id !== requestId) return;
      renderResults(items, search.results.length, textForHighlight, isTagQuery);
    }

    input.addEventListener('input', () => {
      window.clearTimeout(debounce);
      pending = false;
      if (!input.value.trim()) {
        requestId++;
        setView('idle');
        return;
      }
      pending = true;
      debounce = window.setTimeout(() => {
        pending = false;
        void runSearch(input.value);
      }, DEBOUNCE_MS);
    });

    input.addEventListener('keydown', async (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        // Typed faster than the debounce: search now so Enter never opens a stale result.
        if (pending) {
          window.clearTimeout(debounce);
          pending = false;
          await runSearch(input.value);
        }
        const current = list.hidden ? null : list.querySelector<HTMLAnchorElement>('[aria-selected="true"]');
        if (current) void navigate(current.href);
        return;
      }
      const hasResults = !list.hidden && list.children.length > 0;
      if (event.key === 'ArrowDown' && hasResults) {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp' && hasResults) {
        event.preventDefault();
        setActive(active - 1);
      }
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-search-topic]').forEach((button) =>
      button.addEventListener('click', () => {
        input.value = `#${button.dataset.searchTopic}`;
        input.focus();
        window.clearTimeout(debounce);
        pending = false;
        void runSearch(input.value);
      }),
    );

    setView('idle');
  }
</script>
