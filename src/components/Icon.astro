---
/**
 * Lucide icons (https://lucide.dev), drawn at the site's 1.75 stroke. Always decorative: pair each one with
 * visible or visually hidden text. To add an icon, import it from '@lucide/astro/icons/<name>' and list it below.
 * Icons are imported one by one, so a page only builds the ones it uses.
 */
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Copy from '@lucide/astro/icons/copy';
import CornerDownLeft from '@lucide/astro/icons/corner-down-left';
import Download from '@lucide/astro/icons/download';
import FileText from '@lucide/astro/icons/file-text';
import Info from '@lucide/astro/icons/info';
import Mail from '@lucide/astro/icons/mail';
import Menu from '@lucide/astro/icons/menu';
import Moon from '@lucide/astro/icons/moon';
import Search from '@lucide/astro/icons/search';
import Sun from '@lucide/astro/icons/sun';
import X from '@lucide/astro/icons/x';

const icons = {
  'arrow-down': ArrowDown,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'arrow-up': ArrowUp,
  chevron: ChevronDown,
  close: X,
  copy: Copy,
  download: Download,
  enter: CornerDownLeft,
  external: ArrowUpRight,
  file: FileText,
  info: Info,
  mail: Mail,
  menu: Menu,
  moon: Moon,
  search: Search,
  sun: Sun,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Size in pixels. Ignored when `inline` is set. */
  size?: number;
  /** For an icon inside a line of text, e.g. "View all →": sized to the text (1em) and aligned with it. */
  inline?: boolean;
  class?: string;
}

const { name, size = 18, inline = false, class: className } = Astro.props;
const Lucide = icons[name];
---

<Lucide
  class:list={[inline && 'icon-inline', className]}
  size={inline ? '1em' : size}
  stroke-width={1.75}
  aria-hidden="true"
  focusable="false"
/>
